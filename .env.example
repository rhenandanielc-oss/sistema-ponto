# Copie para .env e preencha. NUNCA versione o .env.

# development | production
ENVIRONMENT=development

# Banco (docker-compose)
POSTGRES_DB=ponto
POSTGRES_USER=ponto
POSTGRES_PASSWORD=

# Segredo dos tokens de acesso. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Em desenvolvimento sem HTTPS use false; em produção é obrigatório true.
COOKIE_SECURE=false

APP_TIMEZONE=America/Sao_Paulo

# Chave que cifra os dados biométricos (32 bytes em base64). Guarde uma cópia segura FORA do servidor:
# sem ela, os rostos cadastrados não podem ser lidos e precisam ser cadastrados de novo.
# Gere com: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
BIOMETRIC_KEY=
BIOMETRIC_KEY_ID=k1

# Ajuste fino do reconhecimento (padrões do modelo SFace).
# FACE_MATCH_THRESHOLD=0.363
# FACE_MATCH_MARGIN=0.05

# Origens do frontend, em JSON. Ex.: ["http://localhost:5173"]
CORS_ORIGINS=[]
